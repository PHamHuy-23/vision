SUPABASE_URL=
SUPABASE_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Optional absolute paths. Defaults point to files in the repository root.
# DB_PATH=C:\path\to\vision\video_index_v2.db
# CONSOLIDATED_VECTORS_PATH=C:\path\to\vision\all_vectors.npy
# DATA_ROOT=C:\path\to\vision\data

# Only needed when `agy` is not available on PATH.
# AGY_PATH=C:\Users\your-name\AppData\Local\agy\bin\agy.exe
